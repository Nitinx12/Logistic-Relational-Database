#!/bin/sh
# pre-push hook: run fast checks
if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --hook-stage pre-push --all-files
else
  if [ -f Makefile ] && grep -q "check-fast" Makefile; then
    echo "Running make check-fast..."
    exec make check-fast
  else
    echo "pre-push: no pre-commit or Makefile, skipping"
  fi
fi
