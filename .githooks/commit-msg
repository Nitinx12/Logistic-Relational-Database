#!/bin/sh
# commit-msg hook: validate Conventional Commits if pre-commit is available
if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --hook-stage commit-msg --commit-msg-filename "$1"
else
  msg=$(head -n1 "$1")
  if ! echo "$msg" | grep -Eq "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .+"; then
    echo "Invalid commit message: must be Conventional Commits (e.g., feat(api): add refund endpoint)"
    exit 1
  fi
fi
