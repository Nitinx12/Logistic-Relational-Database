{
  "title": "LRDB Freshness and DQ",
  "panels": [
    {
      "title": "pipeline_end_to_end_lag_seconds",
      "targets": [{"expr": "pipeline_end_to_end_lag_seconds"}],
      "alert": {"conditions": [{"evaluator": {"params": [300], "type": "gt"}}]}
    },
    {
      "title": "dq_gate pass/fail",
      "targets": [{"expr": "dq_gate_passed"}]
    },
    {
      "title": "gold row counts",
      "targets": [{"expr": "gold_rows_total"}]
    }
  ]
}
